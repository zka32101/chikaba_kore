rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザードキュメント
    match /users/{userId} {
      allow read: if request.auth.uid == userId;

      // 書き込み時のセキュリティチェック
      allow create: if request.auth.uid == userId
        && isValidUserCreate(request.resource.data);

      allow update: if request.auth.uid == userId
        && isValidUserUpdate(resource.data, request.resource.data);

      allow delete: if request.auth.uid == userId;

      // サブコレクション: お気に入り
      match /favorites/{favoriteId} {
        allow read: if request.auth.uid == userId;
        allow create, update, delete: if request.auth.uid == userId;
      }
    }

    // 安全ルート機能（あんしんみち由来）の投稿。誰でも閲覧可（地図表示に必要）。
    // status/moderationStatusは作成時は常に'pending'固定を要求し、
    // 'approved'への遷移はCloud Functions（Admin SDK、本ルールの制約を受けない）のみが行う。
    match /shadeSpots/{spotId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.submitterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['tree', 'arcade', 'rain_shelter'];
      allow update, delete: if false;
    }

    match /brightnessSpots/{spotId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.submitterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.brightnessLevel in ['dark', 'normal', 'bright']
        && request.resource.data.reasonType in ['dark', 'low_foot_traffic'];
      allow update, delete: if false;
    }

    // 投稿へのコメント。本人確認済みユーザーのみ作成可（docs/AUTH_STRATEGY_DESIGN.md参照）。
    // moderationStatusはNGワード判定前提のため作成時は常に'pending'固定。
    match /spotComments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.submitterId == request.auth.uid
        && request.resource.data.moderationStatus == 'pending'
        && isVerifiedUser();
      allow update, delete: if false;
    }

    // 施設情報（誰でも読み取り可能、書き込みは管理者のみ）
    match /facilities/{facilityId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // レビュー
    match /reviews/{reviewId} {
      // 承認済みは誰でも閲覧可。本人は自分の投稿を承認待ち含めて閲覧可能。
      // 管理者は承認待ち一覧の確認のため全件閲覧可能。
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && request.auth.uid == resource.data.userId)
        || isAdmin();

      // 作成時は常に status: 'approved' で固定（即時公開のUXは維持）。
      // 連投レート制限・通報しきい値超過の場合のみ、Cloud Functions(Admin SDK)が
      // 事後的に'pending'へ差し戻す（クライアントからは最初からpendingを名乗れない）。
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'approved';

      // 本人による更新はstatusフィールドの変更のみ禁止。
      // 管理者は承認待ち一覧からの承認(status変更)のみ許可(他フィールドは変更不可)。
      allow update: if (request.auth.uid == resource.data.userId
          && request.resource.data.status == resource.data.status)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      // 本人または管理者(却下)による削除を許可。
      allow delete: if request.auth.uid == resource.data.userId || isAdmin();

      // クチコミへの通報。docIdをuserIdにすることで同一ユーザーの二重通報を防ぐ。
      // 通報一覧はクライアントから読めない(Cloud Functionsが件数カウントのみ行う)。
      match /reports/{userId} {
        allow read: if false;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // セキュリティ関数

    // ユーザー作成時の検証
    function isValidUserCreate(data) {
      return data.uid != null
        && data.nickname != null
        && (data.userType == 'local' || data.userType == 'visitor')
        && (!('isPremium' in data) || data.isPremium == false);
    }

    // ユーザー更新時の検証（isPremium・isVerified は Cloud Functions のみ更新可能）
    function isValidUserUpdate(oldData, newData) {
      // isPremium フィールドの直接変更を禁止
      let isPremiumUnchanged = (('isPremium' in oldData) && (newData.isPremium == oldData.isPremium))
        || (!('isPremium' in oldData) && !('isPremium' in newData));

      // isVerified フィールドの直接変更を禁止（本人確認はsyncVerificationStatus経由のみ）
      let isVerifiedUnchanged = (('isVerified' in oldData) && (newData.isVerified == oldData.isVerified))
        || (!('isVerified' in oldData) && !('isVerified' in newData));

      return isPremiumUnchanged
        && isVerifiedUnchanged
        && isValidUserCreate(newData);
    }

    // 管理者チェック
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // 本人確認済みチェック（docs/AUTH_STRATEGY_DESIGN.md参照）。
    // Custom Claimのみで判定し、Firestoreのget()を都度発生させない。
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.isVerified == true;
    }
  }
}
