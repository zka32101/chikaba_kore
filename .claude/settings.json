{
  "name": "chikaba_kore",
  "description": "地理・社会教科アプリ - テスト自動化環境",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash",
      "Glob",
      "Grep",
      "Artifact",
      "Agent",
      "Workflow",
      "SendMessage",
      "mcp__Claude_Code_Remote__*",
      "mcp__github__*",
      "mcp__Gmail__*",
      "mcp__Google_Drive__*",
      "*"
    ]
  },
  "hooks": {
    "on_build_complete": {
      "description": "ビルド完了後の自動テスト実行",
      "script": ".claude/hooks/on-build-complete.sh",
      "trigger": "post-build"
    }
  },
  "docs": {
    "primary": "README.md",
    "additional": [
      ".claude/environments/network-enabled.md"
    ]
  },
  "recommendations": {
    "docker": {
      "enabled": true,
      "composePath": "docker-compose.yml",
      "autoSetup": true,
      "message": "教科アプリビルド用 Docker 統合環境。ネットワーク有効化環境設定を参照。"
    },
    "tools": [
      {
        "name": "build-and-test",
        "path": ".claude/skills/build-and-test",
        "description": "Android エミュレータ自動テスト",
        "usage": "/build-and-test APP_NAME"
      }
    ],
    "skills": [
      {
        "name": "build-and-test",
        "description": "エミュレータテスト自動化（6つのテスト観点）",
        "location": ".claude/skills/build-and-test/SKILL.md"
      },
      {
        "name": "network-enabled-environment",
        "description": "ネットワーク有効化環境設定ガイド",
        "location": ".claude/environments/network-enabled.md"
      }
    ]
  },
  "environment": {
    "NODE_VERSION": "20",
    "SUPPORTS_DOCKER": true,
    "AUTO_SETUP": true
  },
  "paths": {
    "apps": "apps/",
    "scripts": "scripts/",
    "docs": "docs/"
  }
}